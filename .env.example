# AWS Bedrock configuration
# Authentication is handled by AWS credentials configured via `aws configure`.
# No API key is needed here; boto3 reads ~/.aws/credentials automatically.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Cost estimation (USD per million tokens) — update if pricing changes
# Variable names must match what tokenomics/logger.py reads
COST_PER_M_INPUT=3.30
COST_PER_M_OUTPUT=16.50
