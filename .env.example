# Placeholders only. Replace locally; never share .env.
# Blank/unset GEMINI_MODEL defaults to gemini-3.6-flash.
# Instructor-approved quota fallback: gemini-3.5-flash-lite.
GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_MODEL=<your_gemini_model>
# Optional: free, paid, or unknown (default unknown; API does not reveal billing tier).
GEMINI_BILLING_TIER=<your_billing_tier>
# Optional; default tokenomics_gemini_log.jsonl. Historical paths are blocked.
GEMINI_TOKENOMICS_LOG=<your_gemini_log_path>
